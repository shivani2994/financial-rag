# Copy this file to `.env` and adjust as needed. All values have sane
# defaults in config/settings.py, so `.env` only needs to override what's
# different in your environment. No secrets required — everything here is
# open-source and local.

# --- Paths ---
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma

# --- Ingestion (Module 2) ---
PROCESSED_CHUNKS_PATH=./data/processed/chunks.jsonl
CHUNK_MAX_CHARS=1500

# --- Indexing (Module 3) ---
CHROMA_COLLECTION_NAME=financial_rag
BM25_PERSIST_PATH=./data/bm25/bm25.pkl

# --- Embeddings & reranking (Module 3 / 4) ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Retrieval (Module 4) ---
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5

# --- Generation (Module 5) ---
OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434
REFUSAL_CONFIDENCE_THRESHOLD=0.1

# Refusal gate hardening: deterministic pre-generation checks (JSON; see
# config/settings.py for the field-by-field rationale)
COMPANY_ALIASES={"KO": ["coca-cola", "coca cola", "the coca-cola company"], "PEP": ["pepsico", "pepsi"], "MDLZ": ["mondelez", "mondelez international", "mondelēz", "mondelēz international"]}
LIVE_MARKET_DATA_KEYWORDS=["stock price", "share price", "trading price", "current price", "current valuation", "today's price", "today's valuation", "market cap", "market capitalization", "market capitalisation", "trading at", "stock quote", "real-time price", "live price"]

# --- Serving (Module 6) ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Evaluation (Module 7) ---
EVAL_QUESTION_SET_PATH=./eval/question_set.xlsx
QUERY_LOG_PATH=./logs/queries.jsonl
EVAL_RUN_LOG_PATH=./logs/eval_runs.jsonl
TOP_SOURCES_LOGGED=3
RAGAS_JUDGE_MODEL=llama3.2:1b
